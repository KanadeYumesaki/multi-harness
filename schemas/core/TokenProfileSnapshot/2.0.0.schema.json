{
  "$id": "https://fde-harness.local/schemas/core/TokenProfileSnapshot/2.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "context_limit": {
      "minimum": 1,
      "type": "integer"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "counting_adapter_version": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "estimate_assurance": {
      "enum": [
        "EXACT",
        "CONSERVATIVE",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "expires_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "maximum_output_limit": {
      "minimum": 1,
      "type": "integer"
    },
    "model_id": {
      "minLength": 1,
      "type": "string"
    },
    "overheads": {
      "additionalProperties": false,
      "properties": {
        "developer_message_overhead": {
          "minimum": 0,
          "type": "integer"
        },
        "per_message_overhead": {
          "minimum": 0,
          "type": "integer"
        },
        "streaming_frame_overhead": {
          "minimum": 0,
          "type": "integer"
        },
        "structured_output_overhead": {
          "minimum": 0,
          "type": "integer"
        },
        "system_message_overhead": {
          "minimum": 0,
          "type": "integer"
        },
        "tool_definition_overhead": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "system_message_overhead",
        "developer_message_overhead",
        "tool_definition_overhead",
        "per_message_overhead",
        "structured_output_overhead",
        "streaming_frame_overhead"
      ],
      "type": "object"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "provider_id": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "reserved_output_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "reserved_tool_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "retry_fallback_reservation": {
      "minimum": 0,
      "type": "integer"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "TokenProfileSnapshot"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "token_profile_id": {
      "minLength": 1,
      "type": "string"
    },
    "tokenizer_name": {
      "minLength": 1,
      "type": "string"
    },
    "tokenizer_version": {
      "minLength": 1,
      "type": "string"
    },
    "vocabulary_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "token_profile_id",
    "snapshot_hash",
    "provider_id",
    "model_id",
    "tokenizer_name",
    "tokenizer_version",
    "vocabulary_hash",
    "counting_adapter_version",
    "overheads",
    "reserved_output_tokens",
    "reserved_tool_tokens",
    "retry_fallback_reservation",
    "context_limit",
    "maximum_output_limit",
    "estimate_assurance",
    "expires_at"
  ],
  "title": "TokenProfileSnapshot",
  "type": "object"
}
