{
  "$id": "https://fde-harness.local/schemas/core/ArtifactManifest/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "minLength": 1,
      "type": "string"
    },
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_hash_value": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "data_classification": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "ArtifactManifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "size_bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "storage_path": {
      "type": "string"
    },
    "stored_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "trust_level": {
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "artifact_id",
    "content_hash_value",
    "media_type",
    "size_bytes",
    "data_classification",
    "trust_level",
    "stored_at",
    "storage_path"
  ],
  "title": "ArtifactManifest",
  "type": "object"
}
