{
  "$id": "https://fde-harness.local/schemas/core/ApprovalConsumeResult/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "concurrency_group": {
      "minLength": 1,
      "type": "string"
    },
    "consume_result_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "error_code": {
      "const": "APPROVAL_REPLAY"
    },
    "failed_consumes": {
      "const": 1,
      "type": "integer"
    },
    "grant_id": {
      "minLength": 1,
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "ApprovalConsumeResult"
    },
    "schema_set_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "const": "REJECTED"
    },
    "successful_consumes": {
      "const": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "consume_result_id",
    "grant_id",
    "concurrency_group",
    "attempt_id",
    "schema_set_hash",
    "state",
    "error_code",
    "successful_consumes",
    "failed_consumes"
  ],
  "title": "ApprovalConsumeResult",
  "type": "object"
}
