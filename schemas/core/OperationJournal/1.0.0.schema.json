{
  "$id": "https://fde-harness.local/schemas/core/OperationJournal/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "type": "string"
    },
    "base_object_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "durability_level": {
      "type": "string"
    },
    "effect_id": {
      "minLength": 1,
      "type": "string"
    },
    "execution_attempted_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "expected_after_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fencing_token": {
      "minimum": 0,
      "type": "integer"
    },
    "filesystem_id": {
      "type": "string"
    },
    "mount_id": {
      "type": "string"
    },
    "observed_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "operation_journal_id": {
      "minLength": 1,
      "type": "string"
    },
    "parent_file_identity": {
      "type": "string"
    },
    "prepared_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "OperationJournal"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "state": {
      "type": "string"
    },
    "store_version": {
      "minimum": 1,
      "type": "integer"
    },
    "target_file_identity_before": {
      "type": "string"
    },
    "target_relative_path": {
      "type": "string"
    },
    "temp_object_identity": {
      "type": "string"
    },
    "workspace_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "operation_journal_id",
    "effect_id",
    "attempt_id",
    "workspace_id",
    "target_relative_path",
    "base_object_hash",
    "expected_after_hash",
    "fencing_token",
    "durability_level",
    "state",
    "store_version"
  ],
  "title": "OperationJournal",
  "type": "object"
}
