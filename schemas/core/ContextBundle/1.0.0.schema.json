{
  "$id": "https://fde-harness.local/schemas/core/ContextBundle/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "bundle_id": {
      "minLength": 1,
      "type": "string"
    },
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "fragment_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "message_role_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "ContextBundle"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "total_token_count": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "bundle_id",
    "bundle_hash",
    "fragment_ids",
    "total_token_count",
    "message_role_manifest_hash"
  ],
  "title": "ContextBundle",
  "type": "object"
}
