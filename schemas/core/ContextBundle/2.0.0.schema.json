{
  "$id": "https://fde-harness.local/schemas/core/ContextBundle/2.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "compression_artifact_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "context_bundle_id": {
      "minLength": 1,
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "excluded_fragment_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "input_read_capability_set_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "input_read_evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "message_role_manifest_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "ordered_fragment_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "ContextBundle"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "selected_fragment_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "selection_receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "token_budget_policy_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "token_profile_snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "total_estimated_tokens": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "context_bundle_id",
    "bundle_hash",
    "selection_receipt_id",
    "selected_fragment_ids",
    "ordered_fragment_ids",
    "excluded_fragment_ids",
    "compression_artifact_ids",
    "total_estimated_tokens",
    "message_role_manifest_hash",
    "token_profile_snapshot_hash",
    "token_budget_policy_hash",
    "input_read_capability_set_hash",
    "input_read_evidence_hash"
  ],
  "title": "ContextBundle",
  "type": "object"
}
