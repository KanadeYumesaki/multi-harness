{
  "$id": "https://fde-harness.local/schemas/core/ContextFragment/2.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "classification_labels": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 0,
      "type": "array"
    },
    "classification_scan_evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_artifact_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "control_authority": {
      "type": "boolean"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "deduplication_key": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "estimated_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "fragment_id": {
      "minLength": 1,
      "type": "string"
    },
    "fragment_type": {
      "minLength": 1,
      "type": "string"
    },
    "freshness": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "input_read_capability_id": {
      "minLength": 1,
      "type": "string"
    },
    "instruction_eligible": {
      "type": "boolean"
    },
    "mandatory": {
      "type": "boolean"
    },
    "masking_receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "message_role": {
      "enum": [
        "SYSTEM_CONTROL",
        "DEVELOPER_CONTROL",
        "USER_TASK",
        "TOOL_DEFINITION",
        "VERIFIED_REFERENCE_DATA",
        "UNTRUSTED_ARTIFACT_DATA",
        "UNTRUSTED_PROVIDER_DATA"
      ],
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "ContextFragment"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "source_artifact_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "source_file_identity": {
      "minLength": 1,
      "type": "string"
    },
    "source_span": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "trust_level": {
      "enum": [
        "TRUSTED_CONTROL",
        "VERIFIED_INTERNAL",
        "AUTHENTICATED_EXTERNAL",
        "UNTRUSTED_PROVIDER_OUTPUT",
        "UNTRUSTED_EXTERNAL_INPUT",
        "UNKNOWN"
      ],
      "type": "string"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "fragment_id",
    "source_artifact_hash",
    "content_artifact_hash",
    "source_span",
    "fragment_type",
    "message_role",
    "control_authority",
    "instruction_eligible",
    "input_read_capability_id",
    "source_file_identity",
    "classification_scan_evidence_hash",
    "estimated_tokens",
    "classification_labels",
    "trust_level",
    "priority",
    "mandatory",
    "freshness",
    "deduplication_key"
  ],
  "title": "ContextFragment",
  "type": "object"
}
