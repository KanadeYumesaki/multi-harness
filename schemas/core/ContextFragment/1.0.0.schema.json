{
  "$id": "https://fde-harness.local/schemas/core/ContextFragment/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "classification_scan_evidence_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "control_authority": {
      "type": "boolean"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "fragment_content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "fragment_id": {
      "minLength": 1,
      "type": "string"
    },
    "input_read_capability_id": {
      "minLength": 1,
      "type": "string"
    },
    "instruction_eligible": {
      "type": "boolean"
    },
    "masking_receipt_id": {
      "minLength": 1,
      "type": "string"
    },
    "message_role": {
      "enum": [
        "SYSTEM_CONTROL",
        "DEVELOPER_CONTROL",
        "USER_TASK",
        "TOOL_DEFINITION",
        "VERIFIED_REFERENCE_DATA",
        "UNTRUSTED_ARTIFACT_DATA",
        "UNTRUSTED_PROVIDER_DATA"
      ],
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "ContextFragment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    },
    "source_file_identity": {
      "type": "string"
    },
    "token_count": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "fragment_id",
    "message_role",
    "control_authority",
    "instruction_eligible",
    "fragment_content_hash",
    "token_count"
  ],
  "title": "ContextFragment",
  "type": "object"
}
