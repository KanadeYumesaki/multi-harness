{
  "$id": "https://fde-harness.local/schemas/core/PolicyDecision/1.0.0.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_required": {
      "type": "boolean"
    },
    "causation_id": {
      "minLength": 1,
      "type": "string"
    },
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "correlation_id": {
      "minLength": 1,
      "type": "string"
    },
    "created_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "decision": {
      "enum": [
        "ALLOW",
        "DENY"
      ],
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "type": "string"
    },
    "expires_at": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "policy_freshness": {
      "enum": [
        "CURRENT",
        "LKG_WITHIN_TTL",
        "STALE_TTL_EXCEEDED",
        "REVOKED_OR_INVALID",
        "UNKNOWN"
      ],
      "type": "string"
    },
    "policy_snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "producer": {
      "minLength": 1,
      "type": "string"
    },
    "reason_code": {
      "type": "string"
    },
    "record_id": {
      "minLength": 1,
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_name": {
      "const": "PolicyDecision"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "sequence_number": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_name",
    "schema_version",
    "record_id",
    "created_at",
    "producer",
    "content_hash",
    "decision_id",
    "decision",
    "approval_required",
    "policy_snapshot_hash",
    "policy_freshness",
    "expires_at"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
